{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node --experimental-strip-types scripts/generate-calendar.mjs",
    "build": "vinext build",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "start": "vinext start",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern artifacts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/wedding.test.mjs tests/pages-prepare.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "assets:calendar": "node --experimental-strip-types scripts/generate-calendar.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.3",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.3.1",
    "vite": "^8.3.5",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
